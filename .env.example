# neatlogs project API key (app.neatlogs.com -> setup)
NEATLOGS_API_KEY=

# Model provider key - AWS credits do NOT cover model calls
ANTHROPIC_API_KEY=

# Optional overrides
UPSHIFT_MODEL=claude-opus-5-5
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# Optional gateway. Leave blank for Anthropic first-party.
# Token Harbor:  UPSHIFT_BASE_URL=https://tokenharbor.ai
#                UPSHIFT_MODEL=claude-haiku-5.5:free   (the model the headline runs used;
#                put the thk_live_ key in ANTHROPIC_API_KEY)
UPSHIFT_BASE_URL=

# MCP telemetry server for cfo.ai (python -m upshift.mcp_server --port 8787)
UPSHIFT_MCP_PORT=8787
